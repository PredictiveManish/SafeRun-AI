# Sarvam AI (optional) - used only for natural-language explanations.
# When unset, SafeRun uses its local rule-based explanations.
SARVAM_API_KEY=your_key_here

# --- Authentication (required to serve the API) -----------------------------
# Comma separated list of accepted API keys. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SAFERUN_API_KEYS=

# Separate key that allows override=true on code the policy engine blocked.
# Leave empty to disable policy overrides entirely (recommended).
SAFERUN_ADMIN_KEY=

# Set to 1 only for a throwaway local instance with no key configured.
SAFERUN_ALLOW_ANONYMOUS=0

# --- Backend (optional) -----------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Docker sandbox image name
SANDBOX_IMAGE=saferun-sandbox:latest

# Database path (default: sqlite:///./saferun.db)
DATABASE_URL=sqlite:///./saferun.db

# Policy file path (default: backend/policies/default_policy.yaml)
POLICY_FILE=backend/policies/default_policy.yaml

# --- Limits -----------------------------------------------------------------
# Max captured stdout/stderr per execution, in bytes.
SAFERUN_MAX_OUTPUT_BYTES=65536
# Max containers running at the same time.
SAFERUN_MAX_CONCURRENT=4

# Extra browser origins allowed to call the API (comma separated).
# Empty = same origin only, which is what the bundled frontend needs.
SAFERUN_ALLOWED_ORIGINS=
