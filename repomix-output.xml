            "warnings": self.warnings,
            "stdout": self.stdout,
            "stderr": self.stderr,
            "exit_code": self.exit_code,
            "execution_time": self.execution_time,
            "status": self.status,
            "created_at": self.created_at.isoformat(),
        }
